# ============================================================
# Система регистрации товарных знаков РФ — конфигурация
# Скопируйте этот файл в .env и измените значения
# ============================================================

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# SQLite для разработки:
DATABASE_URL=sqlite+aiosqlite:///./trademark.db
# PostgreSQL для production:
# DATABASE_URL=postgresql+asyncpg://trademark:password@localhost:5432/trademark_db

# ------------------------------------------------------------
# Auth / JWT
# ------------------------------------------------------------
# ВАЖНО: Обязательно смените в production!
# Генерация: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-secrets-token-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------
# LLM Provider
# ------------------------------------------------------------
# Варианты: mock | local | openai
LLM_PROVIDER=mock

# Для Ollama (local):
LLM_MODEL=huihui_ai/qwen2.5-abliterate:14b-instruct-q4_K_M
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=

# Для OpenAI:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...

# Для DeepSeek через RouterAI:
# LLM_PROVIDER=routerai
# LLM_MODEL=deepseek/deepseek-v4-flash-0731
# LLM_BASE_URL=https://routerai.ru/api/v1
# LLM_API_KEY=sk-...
# VISION_MODEL=google/gemini-2.5-flash

# Для GigaChat (Authorization Key храните только в .env):
# LLM_PROVIDER=gigachat
# LLM_MODEL=GigaChat-3-Ultra
# LLM_BASE_URL=https://api.giga.chat/v1
# GIGACHAT_AUTHORIZATION_KEY=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# GIGACHAT_VERIFY_SSL=true
# GIGACHAT_CA_BUNDLE_FILE=./certs/russian_trusted_root_ca_pem.crt
# GIGACHAT_MIN_REQUEST_INTERVAL=1.25
# GIGACHAT_MAX_RETRIES=5

# ------------------------------------------------------------
# FIPS Provider (Роспатент / ФИПС)
# ------------------------------------------------------------
# Варианты: mock | rospatent_public | fips
FIPS_PROVIDER=mock
# Публичный предварительный поиск без API-ключа:
# FIPS_PROVIDER=rospatent_public
# FIPS_PUBLIC_BASE_URL=https://searchplatform.rospatent.gov.ru/
# FIPS_PUBLIC_DATA_SOURCES=trademarks,known_trademarks,international_trademarks
# FIPS_PUBLIC_MAX_RESULTS=100
# FIPS_PUBLIC_PAGE_SIZE=50
# FIPS_PUBLIC_MIN_INTERVAL=0.75
# Реальный read-only поиск по Open API поисковой платформы Роспатента:
# FIPS_PROVIDER=fips
# FIPS_BASE_URL=https://searchplatform.rospatent.gov.ru/patsearch/v0.2/
# FIPS_API_KEY=
# Идентификаторы можно получить через GET /datasets после выпуска API-ключа.
# Если списки пусты, приложение попробует обнаружить их по названиям автоматически.
# FIPS_TRADEMARK_DATASETS=
# FIPS_APPLICATION_DATASETS=
# FIPS_CLASS_FILTER_FIELD=classification.icgs
# FIPS_TIMEOUT=30
# FIPS_VERIFY_SSL=true

# ------------------------------------------------------------
# Vector Store (для RAG)
# ------------------------------------------------------------
# Варианты: mock | qdrant | pgvector
VECTOR_STORE_TYPE=mock
VECTOR_STORE_URL=
# VECTOR_STORE_URL=http://localhost:6333  # для Qdrant

# ------------------------------------------------------------
# Redis (очереди фоновых задач, кэш)
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=

# ------------------------------------------------------------
# Feature flags / режим работы
# ------------------------------------------------------------
# Демо-режим запрещает любые реальные внешние действия:
# подачу заявки, отправку писем, изменение внешних систем.
# Для стенда, доступного посторонним, должен быть true.
DEMO_MODE=true

# Фактическая подача заявки во внешний реестр.
# Помимо этого флага требуются DEMO_MODE=false и явное
# подтверждение специалистом (confirm=true в запросе).
ENABLE_REAL_SUBMISSION=false

# ------------------------------------------------------------
# Ограничение частоты запросов
# ------------------------------------------------------------
# Защита от подбора пароля и исчерпания диска загрузками.
RATE_LIMIT_ENABLED=true

# ------------------------------------------------------------
# Файловое хранилище оригиналов документов
# ------------------------------------------------------------
# Каталог, куда складываются загруженные файлы. Адресация по SHA-256.
FILE_STORAGE_PATH=./storage/documents
# Максимальный размер загружаемого файла, МБ
MAX_UPLOAD_MB=25

# OCR сканированных PDF и изображений. Для локального Windows требуется
# Tesseract 5 с языками rus и eng; путь можно указать явно.
OCR_ENABLED=true
OCR_LANGUAGES=rus+eng
OCR_DPI=300
OCR_PSM=3
OCR_MIN_TEXT_CHARS=30
OCR_TIMEOUT_SECONDS=60
# OCR_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# OCR_TESSDATA_DIR=C:\Program Files\Tesseract-OCR\tessdata

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
# Варианты: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------
# JSON-массив строк с разрешёнными origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
DEBUG=false
API_DOCS_ENABLED=true
# Для production перечислите домен и внутренние Docker-имена через запятую.
ALLOWED_HOSTS=*
APP_NAME=Trademark Registration System
APP_VERSION=0.1.0
