# ============================================================
# Система регистрации товарных знаков РФ — конфигурация
# Скопируйте этот файл в .env и измените значения
# ============================================================

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# SQLite для разработки:
DATABASE_URL=sqlite+aiosqlite:///./trademark.db
# PostgreSQL для production:
# DATABASE_URL=postgresql+asyncpg://trademark:password@localhost:5432/trademark_db

# ------------------------------------------------------------
# Auth / JWT
# ------------------------------------------------------------
# ВАЖНО: Обязательно смените в production!
# Генерация: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-secrets-token-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------
# LLM Provider
# ------------------------------------------------------------
# Варианты: mock | local | openai
LLM_PROVIDER=mock

# Для Ollama (local):
LLM_MODEL=huihui_ai/qwen2.5-abliterate:14b-instruct-q4_K_M
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=

# Для OpenAI:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...

# ------------------------------------------------------------
# FIPS Provider (Роспатент / ФИПС)
# ------------------------------------------------------------
# Варианты: mock | soap
FIPS_PROVIDER=mock
# FIPS_WSDL_URL=https://www1.fips.ru/wsdl/...
# FIPS_USERNAME=
# FIPS_PASSWORD=

# ------------------------------------------------------------
# Vector Store (для RAG)
# ------------------------------------------------------------
# Варианты: mock | qdrant | pgvector
VECTOR_STORE_TYPE=mock
VECTOR_STORE_URL=
# VECTOR_STORE_URL=http://localhost:6333  # для Qdrant

# ------------------------------------------------------------
# Redis (очереди фоновых задач, кэш)
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=

# ------------------------------------------------------------
# Feature flags / режим работы
# ------------------------------------------------------------
# Демо-режим запрещает любые реальные внешние действия:
# подачу заявки, отправку писем, изменение внешних систем.
# Для стенда, доступного посторонним, должен быть true.
DEMO_MODE=true

# Фактическая подача заявки во внешний реестр.
# Помимо этого флага требуются DEMO_MODE=false и явное
# подтверждение специалистом (confirm=true в запросе).
ENABLE_REAL_SUBMISSION=false

# ------------------------------------------------------------
# Ограничение частоты запросов
# ------------------------------------------------------------
# Защита от подбора пароля и исчерпания диска загрузками.
RATE_LIMIT_ENABLED=true

# ------------------------------------------------------------
# Файловое хранилище оригиналов документов
# ------------------------------------------------------------
# Каталог, куда складываются загруженные файлы. Адресация по SHA-256.
FILE_STORAGE_PATH=./storage/documents
# Максимальный размер загружаемого файла, МБ
MAX_UPLOAD_MB=25

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
# Варианты: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------
# JSON-массив строк с разрешёнными origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
DEBUG=false
APP_NAME=Trademark Registration System
APP_VERSION=0.1.0
