# Скопируйте в .env.production. Файл .env.production запрещён для Git.
DOMAIN=registr.example.ru

POSTGRES_USER=registr
POSTGRES_PASSWORD=replace_with_a_long_random_hex_password
POSTGRES_DB=registr

SECRET_KEY=replace-with-at-least-64-random-hex-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=postgresql+asyncpg://registr:replace_with_a_long_random_hex_password@postgres:5432/registr

DEBUG=false
API_DOCS_ENABLED=false
ALLOWED_HOSTS=registr.example.ru,localhost,127.0.0.1,api
CORS_ORIGINS=https://registr.example.ru
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
DEMO_MODE=true
ENABLE_REAL_SUBMISSION=false

FILE_STORAGE_PATH=/data/documents
MAX_UPLOAD_MB=25
OCR_ENABLED=true
OCR_LANGUAGES=rus+eng
OCR_DPI=300
OCR_PSM=3
OCR_MIN_TEXT_CHARS=30
OCR_TIMEOUT_SECONDS=60

LLM_PROVIDER=gigachat
LLM_MODEL=GigaChat-3-Ultra
LLM_BASE_URL=https://api.giga.chat/v1
GIGACHAT_AUTHORIZATION_KEY=replace-me
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_VERIFY_SSL=true
GIGACHAT_MIN_REQUEST_INTERVAL=1.25
GIGACHAT_MAX_RETRIES=5

FIPS_PROVIDER=rospatent_public
FIPS_PUBLIC_BASE_URL=https://searchplatform.rospatent.gov.ru/
FIPS_PUBLIC_DATA_SOURCES=trademarks,known_trademarks,international_trademarks
FIPS_PUBLIC_MAX_RESULTS=100
FIPS_PUBLIC_PAGE_SIZE=50
FIPS_PUBLIC_MIN_INTERVAL=0.75

VECTOR_STORE_TYPE=mock
VECTOR_STORE_URL=
REDIS_URL=
